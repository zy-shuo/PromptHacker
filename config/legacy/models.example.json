{
  "defaults": {
    "max_tokens": 2048,
    "aux_model": "deepseek-v3",
    "target_model": "deepseek-r1-32b",
    "embedding_model": "bge-m3"
  },
  "providers": {
    "target": {"api_key": "", "base_url": ""},
    "aux": {"api_key": "", "base_url": ""},
    "embedding": {"api_key": "", "base_url": ""}
  },
  "models": {
    "deepseek-v3": {
      "kind": "chat", "backend": "api", "model": "deepseek-ai/DeepSeek-V3"
    },
    "deepseek-r1-32b": {
      "kind": "chat", "backend": "api", "model": "deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
    },
    "gpt-5": {
      "kind": "chat", "backend": "api", "model": "gpt-5"
    },
    "gpt-4o-mini": {
      "kind": "chat", "backend": "api", "model": "gpt-4o-mini"
    },
    "llama-3-8b-local": {
      "kind": "chat", "backend": "local", "model": "Llama-3-8B-Instruct",
      "local_path": "", "device_map": "auto", "dtype": "bfloat16"
    },
    "bge-m3": {
      "kind": "embedding", "backend": "local", "model": "BAAI/bge-m3",
      "local_path": "", "device": "auto"
    },
    "embedding-api": {
      "kind": "embedding", "backend": "api", "model": "text-embedding-3-small",
      "provider": "embedding"
    }
  }
}
