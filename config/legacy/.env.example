# Target model only.
TARGET_API_KEY=your_target_api_key
TARGET_BASE_URL=https://your-target-provider.example/v1

# Planner, Composer, Evaluator, Reflector, and memory summarizer.
# These models can have different model names on the same API service.
AUX_API_KEY=your_auxiliary_api_key
AUX_BASE_URL=https://your-auxiliary-provider.example/v1

# Optional: a separate embedding service for query/strategy memory.
# Leave both empty to use AUX_API_KEY and AUX_BASE_URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
